{% extends "base.html" %}
{% block hsub %}{{ t(greet) }}{% endblock %}
{% block hextra %}<a class="bell" href="/alerts" aria-label="{{ t('alerts') }}"><svg class="ic" viewBox="0 0 24 24"><path d="M6 16v-5a6 6 0 0 1 12 0v5l1.5 2h-15z"/><path d="M10 21a2 2 0 0 0 4 0"/></svg>{% if n_alerts %}<i></i>{% endif %}</a>{% endblock %}
{% block body %}
<style>
.duo,.trio{display:grid;gap:0}
.duo{grid-template-columns:1fr 1fr}
.trio{grid-template-columns:1fr 1fr 1fr}
.duo>div+div,.trio>div+div{border-left:1px solid var(--line);padding-left:14px}
.trio>div{padding-right:6px}
.dl{display:flex;align-items:center;gap:6px;color:var(--muted);font-size:14px}
.dl .ic{width:16px;height:16px}
.dn{font-size:30px;font-weight:700;margin-top:5px;line-height:1.15}
.trio .dn{font-size:24px}
.dn small{font-size:13px;font-weight:400;color:var(--muted)}
.g{color:var(--green)}
.am{color:var(--amber)}
.qt{margin:0 0 14px;font-size:22px;font-weight:700;color:var(--navy)}
.qa{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.qa a{display:flex;flex-direction:column;align-items:center;gap:10px;padding:18px 6px 14px;background:#eef2f6;border-radius:18px;text-decoration:none;color:var(--ink);font-weight:600;font-size:14px;text-align:center}
.qa a:active{background:#e4eaf0}
.qi{width:54px;height:54px;border-radius:16px;display:flex;align-items:center;justify-content:center}
.qi .ic{stroke:#fff;width:26px;height:26px}
</style>
<div class="card duo">
<div><div class="dl"><svg class="ic" viewBox="0 0 24 24"><path d="M7 5h10M7 9h10M8 5c4.5 0 6.5 1.6 6.5 4s-2 4-6.5 4H7l7 7"/></svg>{{ t('today_collection') }}</div>
<div class="dn g">₹{{ '{:,}'.format(today_coll) }}</div></div>
<div><div class="dl"><svg class="ic" viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="15" rx="2.5"/><path d="M8 3v4M16 3v4M4 10h16M9 15l2 2 4-4"/></svg>{{ t('today_att') }}</div>
<div class="dn">{{ p }} <small>{{ t('present') }} · {{ pct }}%</small></div></div>
</div>
<div class="card trio">
<div><div class="dl"><svg class="ic" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>{{ t('pending') }}</div>
<div class="dn am">₹{{ '{:,}'.format(pa) }}</div></div>
<div><div class="dl"><svg class="ic" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6"/><circle cx="17.5" cy="9" r="2.5"/><path d="M17 14.2c2.6.2 4.5 2 4.5 5.3"/></svg>{{ t('nav_students') }}</div>
<div class="dn">{{ total }} <small>{{ ncls }} {{ t('classes_word') }}</small></div></div>
<div><div class="dl"><svg class="ic" viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="15" rx="2.5"/><path d="M8 3v4M16 3v4M4 10h16"/></svg>{{ t('this_month') }}</div>
<div class="dn g">₹{{ '{:,}'.format(month_coll) }}</div></div>
</div>
<div class="card">
<h3 class="qt">{{ t('quick_actions') }}</h3>
<div class="qa">
<a href="/students/add"><span class="qi" style="background:#222f40"><svg class="ic" viewBox="0 0 24 24"><circle cx="10" cy="8" r="3.5"/><path d="M3.5 20c0-3.6 2.9-6 6.5-6 1.4 0 2.7.4 3.7 1"/><path d="M18 14v6M15 17h6"/></svg></span>{{ t('qa_add') }}</a>
<a href="/hazri"><span class="qi" style="background:#3a566e"><svg class="ic" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l3 3 5-6"/></svg></span>{{ t('qa_mark') }}</a>
<a href="/fees"><span class="qi" style="background:#3a566e"><svg class="ic" viewBox="0 0 24 24"><path d="M7 5h10M7 9h10M8 5c4.5 0 6.5 1.6 6.5 4s-2 4-6.5 4H7l7 7"/></svg></span>{{ t('qa_collect') }}</a>
<a href="/syllabus"><span class="qi" style="background:#222f40"><svg class="ic" viewBox="0 0 24 24"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v16H6.5A2.5 2.5 0 0 0 4 21z"/><path d="M4 5.5v13A2.5 2.5 0 0 1 6.5 16H20M8 7h8M8 10h6"/></svg></span>{{ 'Syllabus' if session.get('lang','en') == 'en' else 'पाठ्यक्रम' }}</a>
<a href="/modelpaper"><span class="qi" style="background:#222f40"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 13h6"/><path d="M9 17h4"/></svg></span>{{ 'मॉडल पेपर' if session.get('lang') == 'hi' else 'Model Paper' }}</a>
<a href="/books"><span class="qi" style="background:#222f40"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg></span>{{ 'पुस्तकें' if session.get('lang') == 'hi' else 'Books' }}</a>
<a href="/kharche"><span class="qi" style="background:#222f40"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3 10h18"/><path d="M7 15h4"/></svg></span>{{ 'ख़र्चे' if session.get('lang') == 'hi' else 'Expenses' }}</a>
</div></div>
{% endblock %}
