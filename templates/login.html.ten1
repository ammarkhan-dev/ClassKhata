{% extends "base.html" %}
{% block body %}
<div class="card" style="margin-top:24px">
<h2 style="margin:0 0 4px;color:#0b2a5b">{{ t('login_title') }}</h2>
<p class="muted" style="margin-top:0">{{ institute or t('login_sub') }}</p>
<form method="post">
<input name="name" placeholder="{{ t('full_name') }}" required autofocus>
<input type="password" name="pw" placeholder="{{ t('password') }}" required>
{% if err %}<p style="color:#d64545;margin:4px 0">{{ t(err) }}</p>{% endif %}
<button>{{ t('login_btn') }}</button>
</form></div>
{% endblock %}
